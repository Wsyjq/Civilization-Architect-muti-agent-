# LLM API 配置（复制本文件为 .env 并填写真实密钥）
# 详细说明见 LLM_SETUP.md

# API 完整URL（兼容OpenAI格式）
# DeepSeek: https://api.deepseek.com/v1/chat/completions
# OpenAI:   https://api.openai.com/v1/chat/completions
LLM_API_URL=

# API 密钥
LLM_API_KEY=

# 模型名称（如 deepseek-chat / gpt-4 / glm-5）
LLM_MODEL=deepseek-chat

# 可选配置
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# 限流与重试（避免429错误）
LLM_RATE_LIMIT_REQUESTS=10
LLM_RATE_LIMIT_TOKENS=10000
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_RETRY_BACKOFF=2.0
LLM_MAX_CONCURRENT=3
